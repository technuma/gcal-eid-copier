{
  "manifest_version": 3,
  "name": "Google Calendar EID Copier",
  "version": "1.0.0",
  "description": "GoogleカレンダーのイベントIDをワンクリックでコピーできるChrome拡張機能",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "イベントのEIDリンクをコピー",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-eid": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "イベントのEIDリンクをコピー"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
